# ─── 构建产物（可完全重新生成，勿入库）─────────────────────────
.pio/
build/
.cache/
compile_commands.json

# ESP-IDF 自动下载的托管组件（由 platformio / idf_component.yml 重新拉取，~432MB）
managed_components/

# 生成的 sdkconfig（源头是 sdkconfig.defaults，那个要入库）
sdkconfig
sdkconfig.esp32s3
sdkconfig.old
sdkconfig.*.old

# 固件/镜像产物
*.bin
*.elf
*.map
*.hex

# ─── IDE / 环境 ─────────────────────────────────────────────
.dummy
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# ─── Python 缓存（Test/motionCapture 标定脚本）────────────────
__pycache__/
*.pyc
*.pyo

# ─── 系统杂项 ───────────────────────────────────────────────
.DS_Store
Thumbs.db
